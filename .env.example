# ==============================================================================
# ETHIXWEB INDIA - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# IMPORTANT SECURITY RULES:
# - Server-only secrets (MONGODB_URI, SESSION_SECRET, TURNSTILE_SECRET_KEY) must
#   NEVER be prefixed with VITE_ or imported into browser-facing code.
# - Only variables prefixed with VITE_ are accessible to the React frontend.
# ==============================================================================

# MongoDB Atlas Connection String (Server-side only)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster0.abcde.mongodb.net/ethixweb_india?retryWrites=true&w=majority

# JWT Session Secret (Server-side only, minimum 32 random characters)
SESSION_SECRET=your_super_secret_jwt_key_at_least_32_characters_long_change_in_production

# Cloudflare Turnstile Spam Protection
# Get keys at: https://dash.cloudflare.com/?to=/:account/turnstile
# In local development, you can use Cloudflare's always-pass testing keys:
# Site Key (Passes): 1x00000000000000000000AA
# Secret Key (Passes): 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Application Base URL
VITE_APP_URL=http://localhost:5173

